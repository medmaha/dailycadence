# The name of the app.
APP_NAME="Cadence"

# The app version number.
APP_VERSION=1

# The OneSignal app ID.
# Go to https://onesignal.com/apps/{YOUR_APP_ID}/settings/keys to find yours.
ONESIGNAL_APP_ID=""

# The OneSignal REST API key.
# Go to https://onesignal.com/apps/{YOUR_APP_ID}/settings/keys to find yours.
ONESIGNAL_REST_API_KEY=""

# The secret token used by the GitHub workflow to authenticate the cron job.
# Go to https://github.com/{YOUR_USERNAME}/{YOUR_REPO}/settings/secrets/actions to create a new secret.
CRON_SECRET=""

# Enable HTTPS in development mode (useful for testing PWA features like push notifications).
USE_DEVELOPMENT_HTTPS=true

# Your production deployment URL (e.g., https://your-domain.com).
VITE_PRODUCTION_URL=""

# The service worker file path (relative to public directory).
VITE_SERVICE_WORKER_FILE_PATH="sw.js"

# Ringtones
# Default reminder sound file path (relative to public directory).
VITE_RINGTONE_FILE="/reminder.mp3"
# Maximum number of custom ringtones a user can upload.
VITE_RINGTONE_MAX_ITEMS=3
# Maximum ringtone file size in KB (500KB).
VITE_RINGTONE_MAX_FILE_SIZE_KB=500
# Maximum compressed ringtone size in KB (100KB after compression).
VITE_RINGTONE_MAX_COMPRESS_SIZE_KB=100

# Reminders
# Maximum number of reminders a user can create.
VITE_REMINDER_MAX_ITEMS=10
# Days to offset when rescheduling reminders (3 days from the last scheduled notification timestamp).
VITE_REMINDER_RESCHEDULE_DAYS_OFFSET=3
# Whether to reschedule push notifications when editing reminder context (time/days).
VITE_REMINDER_RESCHEDULE_PUSH_ON_CONTEXT_EDIT=false

# OneSignal Push Notification Triggers/Schedules
# Maximum number of reminders to schedule at once via OneSignal.
ONESIGNAL_MAX_REMINDER_TO_SCHEDULE=5
# Maximum number of days ahead to schedule reminders via OneSignal.
ONESIGNAL_SCHEDULER_MAX_WINDOW_DAYS=7